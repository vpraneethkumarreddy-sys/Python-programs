import pandas as pd
import numpy as np

data = {
    'House_ID': [101, 102, 103, 104, 105, 102, 106, 107],
    'Price': [250000, 300000, np.nan, '400000', 350000, 300000, 500000, np.nan],
    'Bedrooms': [3, 4, 3, 5, np.nan, 4, 3, 2],
    'Area_SqFt': ['1500', '2000', 'Unknown', '2500', '2200', '2000', '3000', '1800']
}

df = pd.DataFrame(data)

print(df)

df['Price'] = pd.to_numeric(df['Price'], errors='coerce')
df['Price'].fillna(df['Price'].mean(), inplace=True)

df['Bedrooms'].fillna(df['Bedrooms'].mean(), inplace=True)

df = df.drop_duplicates()

df['Area_SqFt'] = pd.to_numeric(df['Area_SqFt'], errors='coerce')
df['Area_SqFt'].fillna(df['Area_SqFt'].mean(), inplace=True)

print(df)

print("Average Price:", df['Price'].mean())
print("Maximum Price:", df['Price'].max())
print("Minimum Price:", df['Price'].min())
print("Average Bedrooms:", df['Bedrooms'].mean())
